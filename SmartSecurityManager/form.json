{
    "elements": [
        {
            "type": "CheckBox",
            "name": "SimulationMode",
            "caption": "Simulationsmodus (Testbetrieb)"
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "SelectModule",
            "name": "RegistryID",
            "caption": "Device Registry",
            "moduleID": "{F3B4A7D9-C59E-401A-B826-17D3B5C2849E}"
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "ExpansionPanel",
            "caption": "📢 Notifier & Eskalation",
            "items": [
                {
                    "type": "Label",
                    "caption": "Wähle hier die SmartNotifier Instanz aus, um Alarme zentral zu melden."
                },
                {
                    "type": "SelectInstance",
                    "name": "TargetNotifier",
                    "caption": "SmartNotifier Instanz"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "EscalationTimeLvl2",
                            "caption": "Stufe 2 (Sekunden)",
                            "suffix": "s"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "EscalationTimeLvl3",
                            "caption": "Stufe 3 (Sekunden)",
                            "suffix": "s"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "🚨 Generische Alarm-Sensoren",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "🔍 Auto-Scan: Fehlende Alarme suchen",
                            "onClick": "SAM_DiscoverVariables($id, true);"
                        },
                        {
                            "type": "Button",
                            "caption": "📥 Alarmmelder aus Registry importieren",
                            "onClick": "SAM_ImportAlarmsFromRegistry($id);"
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "MonitoredVariables",
                    "caption": "Variablen",
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "rowCount": 15,
                    "columns": [
                        {
                            "caption": "Sensor/Auslöser",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Nachricht/Titel",
                            "name": "Message",
                            "width": "250px",
                            "add": "Neuer Alarm",
                            "edit": { "type": "ValidationTextBox" }
                        },
                        {
                            "caption": "Auslöse-Wert",
                            "name": "TriggerValue",
                            "width": "150px",
                            "add": "true",
                            "edit": { "type": "ValidationTextBox" }
                        },
                        {
                            "caption": "Stufe (Level)",
                            "name": "AlarmLevel",
                            "width": "150px",
                            "add": 1,
                            "edit": {
                                "type": "Select",
                                "options": [
                                    { "caption": "Normal (Nur Info)", "value": 0 },
                                    { "caption": "Warnung", "value": 1 },
                                    { "caption": "Fehler / Alarm", "value": 2 }
                                ]
                            }
                        },
                        {
                            "caption": "Auto-Reset",
                            "name": "AutoReset",
                            "width": "100px",
                            "add": false,
                            "edit": { "type": "CheckBox" }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "🚪 Sicherheit: Türen & Fenster (Abwesenheit)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Türen und Fenster werden nun automatisch und live aus der Device Registry (Liste: Fenster- / Türkontakte) überwacht. Sobald ein Kontakt bei Abwesenheit geöffnet wird, löst dies sofort einen Alarm aus. Eine manuelle Pflege in diesem Modul ist nicht mehr erforderlich."
                }
            ]
        }
    ]
}